<%- include("partials/head.ejs") %>

<body>
    <%- include("partials/navbar.ejs") %>

    <div id="new">

        <div class="container">
            <% if (locals.blog) { %>
                <form action="/blogs/<%= id %>/edit" method="post">
                    <label for="title">Title</label>
                    <input type="text" name="title" value="<%= blog.title %>" class="text">

                    <label for="desc">Decription</label>
                    <input type="text" name="desc" value="<%= blog.desc %>" class="text">

                    <label for="content">Content</label>
                    <textarea name="content" class="large-text"><%= blog.content %></textarea>

                    <input type="submit" value="Update" class="submit">
                </form>
            <% } else { %>
                <form action="/new" method="post">
                    <label for="title">Title</label>
                    <input type="text" name="title" class="text">

                    <label for="desc">Decription</label>
                    <input type="text" name="desc" class="text">

                    <label for="content">Content</label>
                    <textarea name="content" class="large-text"></textarea>

                    <input type="submit" value="Submit" class="submit">
                </form>
            <% } %>
        </div>
        
    </div>
</body>